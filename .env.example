# Copy to .env for environment-based secrets. Never commit .env.
# SMTP is optional for sign-in; it is used for email verification and password recovery.
AIOS_SMTP_HOST=
AIOS_SMTP_PORT=465
AIOS_SMTP_USER=
AIOS_SMTP_PASSWORD=
AIOS_SMTP_FROM=
# AIOS_SMTP_SSL=true

# Optional: override the generated machine API token.
# AIOS_API_TOKEN=

# Optional image enhancement runtime paths. Leave unset to disable the optional enhancer.
# AIOS_REALESRGAN_PYTHON=
# AIOS_REALESRGAN_REPO=
# AIOS_REALESRGAN_MODEL=

# Optional launcher overrides. Keep loopback unless you have an authenticated proxy/firewall.
# AIOS_HOST=127.0.0.1
# AIOS_PORT=8080
# AIOS_PYTHON_BIN=
# AIOS_NODE_BIN=
